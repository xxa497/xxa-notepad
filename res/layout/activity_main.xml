<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- ============ 主内容 ============ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- 顶部小栏：左侧菜单按钮 + 居中应用名 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="#2B7DE9"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btn_drawer"
                android:layout_width="48dp"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="☰"
                android:textColor="#FFFFFF"
                android:textSize="22sp" />

            <TextView
                android:id="@+id/tv_title"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="@string/app_name"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />

            <!-- 右侧占位，让标题居中 -->
            <View
                android:layout_width="48dp"
                android:layout_height="1dp" />
        </LinearLayout>

        <!-- 记事列表 -->
        <ListView
            android:id="@+id/list_notes"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:divider="@null"
            android:dividerHeight="0dp"
            android:scrollbars="none" />

        <!-- 空状态 -->
        <TextView
            android:id="@+id/tv_empty"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="还没有记事，在下方输入一条吧"
            android:textColor="#9E9E9E"
            android:textSize="15sp" />

        <!-- 向下插入提示条（点它可取消插入） -->
        <TextView
            android:id="@+id/tv_insert_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#FFF8E1"
            android:gravity="center"
            android:padding="6dp"
            android:text="正在向下方插入记事：输入内容后点发送（点此取消）"
            android:textColor="#F57F17"
            android:textSize="12sp"
            android:visibility="gone" />

        <!-- 底部发送栏 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#F5F5F5"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="6dp">

            <EditText
                android:id="@+id/et_input"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:background="#FFFFFF"
                android:gravity="center_vertical"
                android:hint="@string/input_hint"
                android:imeOptions="actionSend"
                android:inputType="text"
                android:maxLines="3"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"
                android:textColor="#333333"
                android:textColorHint="#9E9E9E"
                android:textSize="15sp" />

            <Button
                android:id="@+id/btn_send"
                android:layout_width="wrap_content"
                android:layout_height="46dp"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_send"
                android:gravity="center"
                android:paddingLeft="18dp"
                android:paddingRight="18dp"
                android:stateListAnimator="@null"
                android:text="@string/send"
                android:textColor="#FFFFFF"
                android:textSize="15sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- ============ 抽屉遮罩（点外部收起） ============ -->
    <View
        android:id="@+id/drawer_scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#66000000"
        android:visibility="gone" />

    <!-- ============ 左侧抽屉菜单（宽度在代码里设为屏宽 1/3） ============ -->
    <LinearLayout
        android:id="@+id/drawer_menu"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:background="#FFFFFF"
        android:clickable="true"
        android:orientation="vertical"
        android:paddingTop="52dp">

        <!-- 顶部标题：纯文字，无边框无底色，明确不可点 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="16dp"
            android:layout_marginRight="16dp"
            android:layout_marginBottom="8dp"
            android:text="@string/app_name"
            android:textColor="#2B7DE9"
            android:textSize="20sp"
            android:textStyle="bold" />

        <!-- 回收站入口（整张卡片可点，与下面版本号同款卡片） -->
        <LinearLayout
            android:id="@+id/card_recycle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="12dp"
            android:layout_marginRight="12dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_card"
            android:clickable="true"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:id="@+id/btn_recycle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/drawer_recycle"
                android:textColor="#333333"
                android:textSize="15sp" />
        </LinearLayout>

        <!-- 私密记录入口 -->
        <LinearLayout
            android:id="@+id/card_private"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="12dp"
            android:layout_marginRight="12dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_card"
            android:clickable="true"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/drawer_private"
                android:textColor="#333333"
                android:textSize="15sp" />
        </LinearLayout>

        <!-- 版本号卡片（与上面同款） -->
        <LinearLayout
            android:id="@+id/card_version"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="12dp"
            android:layout_marginRight="12dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:id="@+id/tv_version"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/version_text"
                android:textColor="#9E9E9E"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- 设置入口 -->
        <LinearLayout
            android:id="@+id/card_settings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="12dp"
            android:layout_marginRight="12dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_card"
            android:clickable="true"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings"
                android:textColor="#333333"
                android:textSize="15sp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
